POSTGRES_URL=jdbc:postgresql://localhost:5532/postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=admin
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/


RABBITMQ_DEFAULT_USER=${RABBITMQ_USERNAME}
RABBITMQ_DEFAULT_PASS=${RABBITMQ_PASSWORD}
RABBITMQ_DEFAULT_VHOST=${RABBITMQ_VIRTUAL_HOST}

# SPRING DATA JPA
SHOW_SQL=true
DDL_AUTO=update
FORMAT_SQL=true
FLYWAY_ENABLED=false
# SECURITY
APP_PROFILE=Dev
FIXR_MODERATOR_USERNAMES=jedidiah
SECURITY_KEY=01a123b7-d2cf-7541-8772-74db437ce14d
FIXR_DOMAIN=localhost
ACCESS_TOKEN_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRATION_DAYS=7


# Fix Report validation
FIXR_VALIDATION_MINIMUM_VOTERS=5
FIXR_VALIDATION_SUPPORT_THRESHOLD=0.75
FIXR_VALIDATION_DISPUTE_THRESHOLD=0.25
FIXR_VALIDATION_SCORE_ADJUSTMENT=2
FIXR_VALIDATION_SCORING_VERSION=1.0
FIXR_VALIDATION_OUTBOX_POLL_INTERVAL_MS=1000
FIXR_VALIDATION_BURST_VOTE_COUNT=5
FIXR_VALIDATION_BURST_WINDOW_MINUTES=10
FIXR_VALIDATION_REPEATED_TARGET_REPORT_COUNT=5
FIXR_VALIDATION_REPEATED_TARGET_WINDOW_DAYS=30
FIXR_VALIDATION_RECIPROCAL_REPORTS_PER_DIRECTION=2
FIXR_VALIDATION_RECIPROCAL_WINDOW_DAYS=90
# EMBEDDING
FIXR_PROXIMITY_THRESHOLD=${EMBEDDING_PROXIMITY_THRESHOLD:-50.0}
FIXR_EMBEDDING_PROXIMITY_WEIGHT=${EMBEDDING_PROXIMITY_WEIGHT:-0.35}
FIXR_EMBEDDING_TEXT_WEIGHT=${EMBEDDING_TEXT_WEIGHT:-0.2}
FIXR_EMBEDDING_VISUALS_WEIGHT=${EMBEDDING_VISUALS_WEIGHT:-0.45}

# CORS
ALLOWED_ORIGINS=http://localhost